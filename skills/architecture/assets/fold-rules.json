{
  "include": "^(src|apps|packages|lib)",
  "roots": ["."],
  "engine": "builtin",
  "tsConfig": false,
  "rules": [
    { "match": "^apps/([^/]+)/", "component": "$1" },
    { "match": "^packages/([^/]+)/", "component": "$1" },
    { "match": "^src/([^/]+)/", "component": "$1" },
    { "match": "^lib/([^/]+)/", "component": "$1" },
    { "match": "^src/[^/]+$", "component": "root" }
  ],
  "registries": [],
  "scanIgnore": [],
  "minorEdgeThreshold": 5
}
